# ============================================================================
# MIND FORTRESS — Configuration Base de Données (Local SQLite Natif & Turso Cloud)
# ============================================================================

# 1. MODE LOCAL (Par défaut) : Vrai SQLite natif sur fichier local
TURSO_DATABASE_URL="file:./mind_fortress.db"
TURSO_AUTH_TOKEN=""

# 2. MODE PRODUCTION (Vercel + Turso Cloud) :
# Décommentez et remplacez par l'URL et le Token fournis par `turso db show` / `turso db tokens create`
# TURSO_DATABASE_URL="libsql://mind-fortress-votre-nom.turso.io"
# TURSO_AUTH_TOKEN="eyJhbGciOiJFZERTQSI..."

PORT=5000
